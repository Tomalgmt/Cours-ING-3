<?xml version="1.0" encoding="UTF-8"?>
<TOOL_CONFIG CONFIG_NAME="NO_LONGER_USED">
    <SUPPORTED_DATA_TYPE CLASS_NAME="ghidra.program.model.listing.Program" />
    <SUPPORTED_DATA_TYPE CLASS_NAME="ghidra.program.model.listing.DataTypeArchive" />
    <ICON LOCATION="greenDragon24.png" />
    <TOOL TOOL_NAME="CodeBrowser" INSTANCE_NAME="">
        <OPTIONS>
            <CATEGORY NAME="Key Bindings">
                <WRAPPED_OPTION NAME="Create Pointer (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed P" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Create Array (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed OPEN_BRACKET" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Clear Components (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed C" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Unpackage Component (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed EQUALS" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Show Numbers In Hex (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="shift pressed H" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Move Components Down (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="alt pressed DOWN" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Move Components Up (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="alt pressed UP" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Duplicate Component (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="alt pressed D" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Duplicate Multiple of Component (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="alt pressed M" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Delete Components (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed DELETE" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Insert Undefined Byte (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="alt pressed U" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
                <WRAPPED_OPTION NAME="Edit Component Field (Shared)" CLASS="ghidra.framework.options.WrappedActionTrigger" LAST_REGISTERED="2026-09-27">
                    <STATE NAME="KeyStroke" TYPE="string" VALUE="pressed F2" />
                    <STATE NAME="MouseBinding" TYPE="string" VALUE="" />
                </WRAPPED_OPTION>
            </CATEGORY>
        </OPTIONS>
        <PACKAGE NAME="Ghidra Core">
            <INCLUDE CLASS="ghidra.app.plugin.core.interpreter.InterpreterPanelPlugin" />
        </PACKAGE>
        <PACKAGE NAME="BSim" />
        <PLUGIN_STATE CLASS="ghidra.app.plugin.core.navigation.GoToAddressLabelPlugin">
            <STATE NAME="CASE_SENSITIVE" TYPE="boolean" VALUE="false" />
            <ARRAY NAME="GO_TO_HISTORY" TYPE="string" />
            <STATE NAME="INCLUDE_DYNAMIC" TYPE="boolean" VALUE="true" />
        </PLUGIN_STATE>
        <PLUGIN_STATE CLASS="ghidra.app.plugin.core.datapreview.DataTypePreviewPlugin">
            <STATE NAME="TerminatedCString" TYPE="string" VALUE="/" />
            <STATE NAME="TerminatedUnicode" TYPE="string" VALUE="/" />
            <STATE NAME="byte" TYPE="string" VALUE="/" />
            <STATE NAME="char" TYPE="string" VALUE="/" />
